# Database (MongoDB connection string — db name must be in the path, e.g. .../clinic?retryWrites=true&w=majority)
DATABASE_URL="mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/clinic-admin?retryWrites=true&w=majority"

# Custom auth (access/refresh tokens signed with this — generate with: openssl rand -base64 32)
JWT_SECRET="generate-with-openssl-rand-base64-32"

# Shopify
SHOPIFY_STORE_URL="clinicdirect.myshopify.com"
SHOPIFY_ADMIN_API_KEY="shpat_..."
SHOPIFY_WEBHOOK_SECRET="..."

# Orderwise
ORDERWISE_API_URL="https://api.orderwise.co.uk/v2"
ORDERWISE_API_KEY="ow_live_..."
ORDERWISE_COMPANY_CODE="CLD001"
