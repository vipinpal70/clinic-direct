// Clinic Direct Admin — Prisma schema (MongoDB)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────

enum ClinicStatus {
  active
  pending
  suspended
  inactive
}

// Distinguishes clinic records from individual client/patient records —
// both live in the `clinics` collection, bifurcated by the Shopify `tags` field.
enum ClinicTag {
  clinic
  client
}

enum AgreementStatus {
  not_sent
  sent
  viewed
  accepted
}

enum OrderStatus {
  pending
  processing
  fulfilled
  refunded
  cancelled
}

enum CommissionStatus {
  payable
  approved
  paid
  cancelled
}

enum InvoiceStatus {
  draft
  issued
  pushed
  paid
  voided
}

enum UserRole {
  super_admin
  admin
  finance
  support
  read_only
}

enum UserStatus {
  active
  invited
  suspended
}

// ─── Embedded (composite) types ───────────────────────────────

// Bank + tax details the clinic supplies via the public intake page —
// Shopify does not expose these, so they're collected separately.
type BankDetails {
  accountHolderName String @default("")
  bankName          String @default("")
  accountNumber     String @default("")
  sortCode          String @default("")
}

type TaxExempt {
  exemptStatus            Boolean @default(false)
  exemptionTypeCode       String  @default("")
  exemptionCertificateUrl String  @default("")
  vatId                   String  @default("")
}

// ─── Models ───────────────────────────────────────────────────

model Clinic {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  code            String          @unique // permanent unique id: CUST-<shopifyId> for Shopify customers; used in portal links
  clinicCode      String?         // business code from the Shopify note; orders match on this (see lib/clinic-code.ts)
  tag             ClinicTag       @default(clinic) // clinic vs individual client/patient
  shopifyCustomerId String?       // stable Shopify identity — the primary match key on ingest (see lib/shopify-ingest.ts)
  businessName    String?         // parsed from the Shopify customer note
  vatNumber       String?         // parsed from the Shopify customer note
  email           String
  phone           String?
  status          ClinicStatus    @default(pending)
  agreement       AgreementStatus @default(not_sent)
  commissionPct   Float           @default(12)
  joined          DateTime?       @default(now())
  address         String?
  website         String?
  notes           String?
  loginEmail      String?
  loginHash       String?         // bcrypt hash of portal password

  // Profile-completion email tracking. First send is automatic on ingest
  // (see lib/shopify-ingest.ts); subsequent sends are the admin "Resend" button.
  emailSentCount  Int             @default(0)
  emailSentAt     DateTime?

  // Clinic-supplied intake (public page → Step 1)
  bankDetails        BankDetails?
  taxExempt          TaxExempt?
  detailsSubmittedAt DateTime?

  // Per-clinic agreement / consent (Step 2)
  agreementId            String?   // random id embedded in the public link (queried with code)
  agreementSnapshot      String?           // frozen HTML at send time — the consent form
  agreementCommissionPct Float?            // rate offered on the agreement (applied on approval)
  agreementExpiry        DateTime?
  agreementSentAt        DateTime?
  agreementAcceptedAt    DateTime?
  agreementApprovedAt    DateTime?
  agreementSignedName    String?
  agreementLocked        Boolean   @default(false) // once approved, no more edits

  orders          Order[]
  commissions     Commission[]
  invoices        Invoice[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([clinicCode])
  @@index([shopifyCustomerId])
  @@map("clinics")
}

model Order {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  shopifyId       String      @unique
  number          String
  clinicId        String?     @db.ObjectId
  clinic          Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  status          OrderStatus @default(pending)
  total           Float
  commission      Float
  commissionPct   Float
  items           Int         @default(1)
  customerName    String?
  customerEmail   String?
  lineItems       Json?       // Raw Shopify line items
  refundAmount    Float?
  notes           String?
  shopifyCreatedAt DateTime
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([clinicId])
  @@index([status])
  @@index([shopifyCreatedAt])
  @@map("orders")
}

model Commission {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  clinicId        String?          @db.ObjectId
  clinic          Clinic?          @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  period          String           // "2026-07"
  gross           Float
  commission      Float
  rate            Float
  vat             Float            @default(0)
  status          CommissionStatus @default(payable)
  invoiceId       String?          @db.ObjectId
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([clinicId])
  @@index([period])
  @@index([status])
  @@map("commissions")
}

model Invoice {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  number          String        @unique
  clinicId        String?       @db.ObjectId
  clinic          Clinic?       @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  commission      Float
  vat             Float
  total           Float
  status          InvoiceStatus @default(draft)
  periodStart     DateTime?
  periodEnd       DateTime?
  pushedAt        DateTime?     // When pushed to Orderwise
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([clinicId])
  @@index([status])
  @@map("invoices")
}

model CommissionRule {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  scope           String   // "default" | "product:{id}" | "clinic:{id}" | "category:{slug}"
  scopeLabel      String   // Human-readable label
  basis           String   // "percentage" | "fixed"
  value           Float    // Percentage or fixed amount
  appliesToLabel  String
  priority        Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active])
  @@map("commission_rules")
}

model AdminUser {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String     @unique
  password        String     // stored as plain text (explicit product decision — not hashed)
  role            UserRole   @default(read_only)
  twoFaSecret     String?
  twoFaEnabled    Boolean    @default(false)
  status          UserStatus @default(invited)
  lastLoginAt     DateTime?
  invitedAt       DateTime?
  invitedBy       String?    @db.ObjectId
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  auditLogs       AuditLog[]
  sessions        Session[]

  @@map("admin_users")
}

model Session {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  user            AdminUser @relation(fields: [userId], references: [id])
  refreshTokenHash String   @unique // sha256 of the refresh token, never the raw token
  userAgent       String?
  ipAddress       String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime  // absolute 8h cap from login — never extended by refreshes
  revokedAt       DateTime?

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String?   @db.ObjectId
  user            AdminUser? @relation(fields: [userId], references: [id])
  userEmail       String
  action          String    // e.g. "clinic.approved", "order.synced"
  target          String    // What was acted on
  prevValue       String?
  newValue        String?
  ipAddress       String?
  metadata        Json?
  createdAt       DateTime  @default(now())

  @@index([userEmail])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model IntegrationConfig {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  provider        String   @unique // "shopify" | "orderwise" | "clarity"
  config          Json     // Encrypted credentials and settings
  active          Boolean  @default(true)
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("integration_configs")
}

model WebhookLog {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  provider        String   // "shopify"
  event           String   // "orders/create"
  resourceId      String
  attempts        Int      @default(1)
  status          String   // "success" | "failed" | "retrying"
  payload         Json?
  error           String?
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([provider])
  @@index([status])
  @@map("webhook_logs")
}

// Raw capture of EVERY inbound webhook HTTP request — one row per delivery,
// append-only, written before any auth/parse check can reject it (see
// lib/webhook-capture.ts). `WebhookLog` above records processing outcome per
// resource; this records exactly what the sender delivered, for debugging and
// for discovering the real payload shape (Integrations → Webhook events).
model WebhookEvent {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  endpoint       String    // "shopify" | "clinic-data" | "clinic-order-data"
  method         String?   // HTTP method, e.g. "POST"
  url            String?   // full request URL as the caller saw it; secret-looking query values redacted
  topic          String?   // X-Shopify-Topic, e.g. "orders/create"
  shopDomain     String?   // X-Shopify-Shop-Domain
  webhookId      String?   // X-Shopify-Webhook-Id — identical across Shopify retries
  eventId        String?   // X-Shopify-Event-Id
  apiVersion     String?   // X-Shopify-API-Version — decides the payload shape
  triggeredAt    DateTime? // X-Shopify-Triggered-At
  headers        Json?     // allow-listed headers; secrets stored as "[redacted]"
  payload        Json?     // parsed JSON body, exactly as received
  rawBody        String?   // only when the body isn't valid JSON or is too large to store parsed
  bodyBytes      Int       @default(0)
  resourceId     String?   // top-level `id` of a single-object payload
  recordCount    Int?      // records in the body (1, or the batch array length)
  signatureValid Boolean?  // Shopify HMAC check; null when no header or no secret configured
  status         String    // "received" | "processed" | "failed" | "rejected" | "error"
  httpStatus     Int?      // status we replied with
  response       Json?     // body we replied with (summarised when large)
  error          String?
  durationMs     Int?
  receivedAt     DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([endpoint, receivedAt])
  @@index([topic, receivedAt])
  @@index([status])
  @@index([webhookId])
  @@index([receivedAt])
  @@map("webhook_events")
}
